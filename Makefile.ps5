# ps5share - compilación del payload para PS5
# Requiere ps5-payload-sdk: https://github.com/ps5-payload-dev/sdk
#   ./third_party/fetch.sh            (una vez: descarga wolfSSL/wolfSSH)
#   export PS5_PAYLOAD_SDK=/opt/ps5-payload-sdk
#   make -f Makefile.ps5

PS5_HOST ?= ps5
PS5_PORT ?= 9021

ifdef PS5_PAYLOAD_SDK
    include $(PS5_PAYLOAD_SDK)/toolchain/prospero.mk
else
    $(error PS5_PAYLOAD_SDK no está definido)
endif

VERSION_TAG := $(shell git describe --abbrev=6 --dirty --always --tags 2>/dev/null || echo dev)
BUILD := build/ps5

include third_party/wolf.mk

CFLAGS := -Wall -Werror -O2 -DVERSION_TAG=\"$(VERSION_TAG)\" -Isrc \
          -DWOLFSSL_USER_SETTINGS -I$(WOLF_DIR) -I$(WOLF_DIR)/wolfssl -I$(WOLF_DIR)/wolfssh -I$(WOLF_DIR)/cjson

SOURCE := src/app.c src/config.c src/vfs.c src/crypt.c src/ftp.c src/http.c src/sftp.c src/io.c src/smtp.c src/tsip.c src/tls.c src/bwcrypto.c src/vault.c src/vaultweb.c src/net.c src/json.c src/library.c src/spotify.c src/fan.c
SOURCE += src/sha256.c src/totp.c src/notify.c src/main-prospero.c src/ps5compat.c

WOLF_OBJ := $(patsubst %.c,$(BUILD)/%.o,$(WOLF_SRC))

all: ps5nas.elf

$(WOLF_DIR)/wolfssl/wolfcrypt/src/aes.c:
	@echo "Faltan las dependencias: ejecuta ./third_party/fetch.sh"; exit 1

$(BUILD)/%.o: %.c $(WOLF_DIR)/user_settings.h
	@mkdir -p $(dir $@)
	$(CC) -O2 $(WOLF_CFLAGS) -c $< -o $@

$(BUILD)/libwolf.a: $(WOLF_OBJ)
	$(AR) rcs $@ $^

src/webui.h: web/index.html tools/embed.py
	python3 tools/embed.py $< $@

src/gwscript.h: gateway/ps5nas-gateway.sh tools/embed.py
	python3 tools/embed.py $< $@ gateway_script

ps5nas.elf: $(SOURCE) src/webui.h src/gwscript.h $(wildcard src/*.h) $(BUILD)/libwolf.a
	$(CC) $(CFLAGS) -o $@ $(SOURCE) $(BUILD)/libwolf.a -lpthread -lkernel_sys

clean:
	rm -rf ps5nas.elf $(BUILD)

test: ps5nas.elf
	$(PS5_DEPLOY) -h $(PS5_HOST) -p $(PS5_PORT) $<

.PHONY: all clean test
