# ps5share - compilación del payload para PS5
# Requiere ps5-payload-sdk: https://github.com/ps5-payload-dev/sdk
#   export PS5_PAYLOAD_SDK=/opt/ps5-payload-sdk
#   make -f Makefile.ps5

PS5_HOST ?= ps5
PS5_PORT ?= 9021

ifdef PS5_PAYLOAD_SDK
    include $(PS5_PAYLOAD_SDK)/toolchain/prospero.mk
else
    $(error PS5_PAYLOAD_SDK no está definido)
endif

VERSION_TAG := $(shell git describe --abbrev=6 --dirty --always --tags 2>/dev/null || echo dev)

CFLAGS := -Wall -Werror -O2 -DVERSION_TAG=\"$(VERSION_TAG)\" -Isrc

SOURCE := src/app.c src/config.c src/vfs.c src/ftp.c src/http.c src/io.c
SOURCE += src/sha256.c src/notify.c src/main-prospero.c

all: ps5share.elf

src/webui.h: web/index.html tools/embed.py
	python3 tools/embed.py $< $@

ps5share.elf: $(SOURCE) src/webui.h $(wildcard src/*.h)
	$(CC) $(CFLAGS) -o $@ $(SOURCE) -lpthread

clean:
	rm -f ps5share.elf

test: ps5share.elf
	$(PS5_DEPLOY) -h $(PS5_HOST) -p $(PS5_PORT) $<

.PHONY: all clean test
